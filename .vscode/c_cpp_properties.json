{
    "configurations": [
        {
            "name": "Linux-GCC",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/backend/**",
                "/usr/include/c++/**",
                "/usr/include/x86_64-linux-gnu/c++/**",
                "/usr/include/**"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "compileCommands": "${workspaceFolder}/backend/build/compile_commands.json"
        },
        {
            "name": "Emscripten",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/backend/**",
                "${env:EMSDK}/upstream/emscripten/system/include",
                "${env:EMSDK}/upstream/emscripten/system/include/emscripten",
                "${workspaceFolder}/emsdk/upstream/emscripten/system/include",
                "${workspaceFolder}/emsdk/upstream/emscripten/system/include/emscripten"
            ],
            "defines": [
                "__EMSCRIPTEN__"
            ],
            "compilerPath": "${env:EMSDK}/upstream/emscripten/em++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "clang-x64"
        }
    ],
    "version": 4
}